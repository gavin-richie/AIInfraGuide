---
import { getCollection } from 'astro:content';
import { flattenAnswerOrder, topicColor } from '../utils/answerGrouping';

interface Props {
  urlPrefix?: string;
}

const { urlPrefix = '/answers' } = Astro.props;

const answers = await getCollection('answers', ({ data }) => !data.draft);
const items = flattenAnswerOrder(answers);
const currentPath = decodeURIComponent(Astro.url.pathname);

const getAnswerPath = (id: string) => {
  const base = import.meta.env.BASE_URL;
  const path = `${urlPrefix}/${id}`;
  return base === '/' ? path : `${base.replace(/\/$/, '')}${path}`;
};

const isActivePath = (id: string) => {
  const normalizedCurrent = currentPath.replace(/\/$/, '');
  const normalizedItem = getAnswerPath(id).replace(/\/$/, '');
  return normalizedCurrent === normalizedItem;
};
---

<nav class="w-72 shrink-0 sticky top-24 h-[calc(100vh-8rem)] overflow-y-auto sidebar-scroll pr-2">
  <div class="px-3 mb-3">
    <span class="text-xs font-semibold text-gray-900 dark:text-gray-100 tracking-wide">
      面试题解答
    </span>
    <span class="text-[10px] text-gray-400 dark:text-gray-500 font-medium ml-1.5 tabular-nums">
      {items.length} 篇
    </span>
  </div>

  <ul class="relative ml-[11px] border-l border-gray-200 dark:border-white/[0.06] space-y-px">
    {items.map((item) => {
      const href = getAnswerPath(item.id);
      const isActive = isActivePath(item.id);
      const color = topicColor(item.data.topic);
      return (
        <li class="relative">
          {isActive && (
            <div
              class="absolute left-0 top-1.5 bottom-1.5 w-[2px] -translate-x-[1px] rounded-full"
              style={`background: ${color};`}
            />
          )}
          <a
            href={href}
            data-active={isActive ? 'true' : undefined}
            class:list={[
              'flex items-center gap-2 ml-4 px-3 py-1.5 rounded-lg text-[13px] leading-snug transition-all duration-200 cursor-pointer',
              isActive
                ? 'text-gray-900 dark:text-white font-medium bg-gray-100 dark:bg-white/[0.06]'
                : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-white/[0.04]',
            ]}
          >
            <span
              class="w-1.5 h-1.5 rounded-full shrink-0"
              style={`background: ${color};`}
            />
            {item.data.title}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 滚动 active 项到可视区
    const sidebar = document.querySelector('.sidebar-scroll') as HTMLElement | null;
    const activeLink = sidebar?.querySelector('a[data-active="true"]') as HTMLElement | null;
    if (sidebar && activeLink) {
      const sidebarRect = sidebar.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const offset = linkRect.top - sidebarRect.top - sidebarRect.height / 2 + linkRect.height / 2;
      sidebar.scrollTop += offset;
    }
  });
</script>
